# ==============================================================================
# ABDOU PHONE - EXEMPLE DE CONFIGURATION (.env.example)
# Copiez ce fichier vers .env.local et renseignez vos clés réelles.
# ==============================================================================

# 1. BASE DE DONNÉES MONGODB
# Pour MongoDB Atlas :
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/abdou_phone?retryWrites=true&w=majority
# Pour MongoDB local :
MONGODB_URI=mongodb://localhost:27017/abdou_phone

# 2. CLOUDINARY (Images et Fichiers Médias)
# https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 3. SÉCURITÉ & AUTHENTIFICATION
JWT_SECRET=your_strong_jwt_secret_key_minimum_32_characters
NEXT_PUBLIC_APP_URL=http://localhost:3001
ADMIN_EMAIL=admin@abdouphone.dz
ADMIN_PASSWORD=your_secure_admin_password
